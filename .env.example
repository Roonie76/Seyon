# Seyon — environment
#
# Extends the original example rather than replacing it: this file already
# existed and covered the basics. What it did not cover was everything added
# since — email, the scheduled job secret, rate limiting, the compliance
# contacts — so a deployment could satisfy it completely and still have silent
# holes. Every variable below was found by sweeping `process.env` across src/
# rather than written from memory. Copy to `.env` and fill in.
#
# Levels:
#   REQUIRED  the app refuses to boot in production without it
#   IMPORTANT it boots, but something silently does not work
#   OPTIONAL  a fallback exists and is fine
#
# `npm run dev` prints a check of all of these on boot. Read it.

# ─────────────────────────────────────────────────────────── database
# REQUIRED. Pooled connection for the app, direct connection for migrations.
# On Supabase these differ by port: 6543 pooled, 5432 direct.
# A password containing % must be percent-encoded — %25 for a literal %.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ───────────────────────────────────────────────────────────── auth
# REQUIRED. Long random string; rotating it signs everyone out.
AUTH_SECRET=""
NEXTAUTH_SECRET=""
# REQUIRED in production. The origin NextAuth builds callback URLs from.
NEXTAUTH_URL="http://localhost:3000"

# REQUIRED for sign-in. Google OAuth client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OPTIONAL, development only. Passwordless login as any email — ignored in
# production, but never point a dev server carrying this at a production
# database: it will sign you in as any real user by typing their address.
ALLOW_INSECURE_DEV_LOGIN="false"

# OPTIONAL. Lets a Google sign-in attach to an existing account with the same
# address. Off by default because it trusts the provider's email verification.
ALLOW_DANGEROUS_ACCOUNT_LINKING="false"

# ────────────────────────────────────────────────────────────── hosts
# IMPORTANT. Canonical public origin. Used for canonical tags, the sitemap,
# OpenGraph, and every link inside a transactional email. Unset, emails point
# at localhost — which is visibly wrong, and better than the bare paths they
# used to contain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# IMPORTANT for the two-host setup: the shopper-facing origin, as linked to
# from seller screens. Comma-separated seller hostnames in SELLER_HOSTS.
BUYER_MARKET_URL="http://localhost:3000"
SELLER_HOSTS="seyon-seller.vercel.app,localhost:3001"

# ────────────────────────────────────────────────────────── storage
# REQUIRED for image and document upload. Without these, uploads fail and
# product images fall back to stock photos.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# The publishable key. Safe in a browser; the service-role key above is not.
SUPABASE_ANON_KEY=""

# ─────────────────────────────────────────────────────────────── email
# IMPORTANT. Without these, notify() silently does nothing: sellers are never
# emailed about suspensions, notices, reviews or complaint outcomes. The notice
# itself still reaches their dashboard, which is why this is not fatal — but
# "we told them" stops being true.
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL=""

# ─────────────────────────────────────────────────── scheduled work
# REQUIRED for the nightly job. Without it /api/cron/daily answers 503 to
# everything, so abandoned identity documents are never swept, sellers who
# ignore a notice are never chased, and nobody is told when complaints are
# about to breach their deadline. Long random string; Vercel sends it as
# `Authorization: Bearer <value>`.
CRON_SECRET=""

# ───────────────────────────────────────────────── rate limiting
# OPTIONAL. Without Upstash, limits fall back to Postgres — correct across
# instances, one extra write per limited request. Fine at this size.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ──────────────────────────────────────────────────────── compliance
# IMPORTANT. The DPDP Act 2023 and the Consumer Protection (E-Commerce) Rules
# 2020 require a named individual with published contact details. Unset, the
# policy pages say the appointment is pending, which is honest but not
# compliant.
NEXT_PUBLIC_GRIEVANCE_NAME=""
NEXT_PUBLIC_GRIEVANCE_DESIGNATION="Grievance Officer"
NEXT_PUBLIC_GRIEVANCE_EMAIL=""
NEXT_PUBLIC_GRIEVANCE_ADDRESS=""

# OPTIONAL. The addresses printed across the site. Defaults are @seyon.in —
# override if that domain does not receive mail, because the address in the
# legal pages is the one a regulator or an unhappy buyer will use.
NEXT_PUBLIC_CONTACT_SUPPORT=""
NEXT_PUBLIC_CONTACT_PRIVACY=""
NEXT_PUBLIC_CONTACT_LEGAL=""

# OPTIONAL. The Instagram account linked from the blog sidebar, with or
# without the leading @. Unset hides that panel rather than showing a
# fabricated feed.
NEXT_PUBLIC_INSTAGRAM_HANDLE=""

# OPTIONAL. The marketplace's own WhatsApp number, digits with country code.
# Unset hides the footer's WhatsApp control entirely — a missing contact is
# better than one that reaches a stranger.
NEXT_PUBLIC_SUPPORT_WHATSAPP=""

# ────────────────────────────────────────────────────── seller identity
# OPTIONAL. Which KYC backend to use. Unset means manual review: submissions
# queue for a human and are never auto-approved.
KYC_PROVIDER="manual"

# ──────────────────────────────────────────────── WhatsApp verification
# OPTIONAL. Meta Cloud API, for verifying a seller owns their number. Without
# these the verification step cannot send a code.
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TEMPLATE_NAME=""
WHATSAPP_VERIFY_TEMPLATE_LANGUAGE="en"

# ──────────────────────────────────────────────────────── observability
# IMPORTANT before launch. Without PostHog there is no funnel and no
# activation data — you will not know whether anyone got through signup.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# IMPORTANT. Without a DSN, runtime errors are reported nowhere at all.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Build-time only, for uploading source maps so a stack trace is readable.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
