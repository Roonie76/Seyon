# Database Connection (local postgres via docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seyon?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="your_nextauth_secret_minimum_32_characters_long"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Supabase Storage Credentials (for image uploads)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# PostHog Analytics Configurations
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-api-key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Sentry error monitoring (optional locally; set these in production/CI)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# WhatsApp Cloud API verification (optional; email fallback is used when unset)
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TEMPLATE_NAME=""
WHATSAPP_VERIFY_TEMPLATE_LANGUAGE="en"

# Canonical public site URL (used for SEO: sitemap, canonical URLs, OpenGraph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seller platform hostnames (comma-separated, exact match) for root middleware domain routing
SELLER_HOSTS="seyon-seller.vercel.app,localhost:3001"

# Dev login escape hatch: force-enables the passwordless email login OUTSIDE local dev.
# NEVER set this on a production domain.
# ALLOW_INSECURE_DEV_LOGIN="true"

# Dangerous Account Linking: enables automatic account merging between credentials
# and Google OAuth accounts when emails match. Only activate when required.
# ALLOW_DANGEROUS_ACCOUNT_LINKING="true"

# Transactional email (optional - notifications no-op when unset)
# RESEND_API_KEY="re_..."
# NOTIFY_FROM_EMAIL="Seyon <notifications@yourdomain.com>"

# Scheduled daily jobs authentication secret
# Must match between Vercel Cron headers (Authorization: Bearer <CRON_SECRET>) and the API route
CRON_SECRET="your_cron_secret_minimum_32_characters_long"
