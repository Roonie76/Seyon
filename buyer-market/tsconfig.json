{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/frontend/components/*"],
      "@/actions/*": ["./src/backend/actions/*"],
      "@/lib/auth": ["./src/backend/lib/auth"],
      "@/lib/db": ["./src/backend/lib/db"],
      "@/lib/supabase": ["./src/backend/lib/supabase"],
      "@/lib/posthog": ["./src/frontend/lib/posthog"],
      "@/lib/utils": ["./src/frontend/lib/utils"],
      "@/lib/seo": ["./src/shared/lib/seo"],
      "@/lib/site": ["./src/shared/lib/site"],
      "@/lib/zod-schemas": ["./src/shared/lib/zod-schemas"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
