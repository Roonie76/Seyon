datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  SELLER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  /// Looked at and found unfounded. Deliberately distinct from RESOLVED, which
  /// means something was actually done. Collapsing the two makes it impossible
  /// to tell "we fixed it" from "there was nothing to fix" — and the second is
  /// the one a wrongly-reported seller is entitled to hear.
  REJECTED
}

/// What a complaint is actually about.
///
/// `Report.reason` is free text: fine for the reporter, useless for everyone
/// after them, because it cannot be counted, filtered or escalated. A category
/// turns "this store has had four counterfeit reports this month" into a query
/// rather than a reading exercise.
/// What a complaint is about. One Report model covers both, because the
/// acknowledgement and disposal deadlines are the same either way.
enum ReportTarget {
  SHOP
  REVIEW
}

enum ReportCategory {
  COUNTERFEIT
  PROHIBITED_ITEM
  FRAUD_OR_SCAM
  MISLEADING_LISTING
  OFFENSIVE_CONTENT
  IMPERSONATION
  NON_DELIVERY
  OTHER
}

/// The kinds of thing a marketplace formally tells a seller.
enum NoticeKind {
  WARNING
  POLICY_VIOLATION
  INFORMATION_REQUEST
  SUSPENSION
  REINSTATEMENT
}

enum AnalyticsEventType {
  SHOP_VIEW
  PRODUCT_VIEW
  WHATSAPP_CLICK
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          Role      @default(USER)
  sellerName    String?
  sellerPhone   String?
  sellerImage   String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String?   @default("India")
  isBeta        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  shop         Shop?
  reviews      Review[]
  reports      Report[]
  wishlist     Wishlist[]
  analytics    Analytics[]
  sellerKyc    SellerKyc?
  kycReviewed  SellerKyc[]       @relation("KycReviewer")
  adminActions AdminAction[]     @relation("AdminActor")
  slugChanges  ShopSlugHistory[] @relation("SlugChanger")

  // Moderation trails. All SetNull or Restrict rather than Cascade: deleting an
  // admin account must never quietly erase the record of what they decided.
  hiddenReviews          Review[] @relation("ReviewModerator")
  acknowledgedReports    Report[] @relation("ReportAcknowledger")
  noticesSent            Notice[] @relation("NoticeAuthor")
  shopsPlacedUnderReview Shop[]   @relation("ShopUnderReviewBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Shop {
  id                 String    @id @default(cuid())
  ownerId            String    @unique
  name               String
  slug               String    @unique
  description        String?
  logo               String?
  banner             String?
  whatsapp           String
  instagram          String?
  telegram           String?
  city               String?
  region             String?
  deliveryNote       String?
  isVerified         Boolean   @default(false)
  isSuspended        Boolean   @default(false)
  isPaused           Boolean   @default(false)
  /// Discoverable in marketplace, search and sitemap. False until the
  /// owner completes Tier 0 identity. A store is always reachable by
  /// direct link so a seller can see their own work before verifying.
  isListed           Boolean   @default(false)
  /// Under investigation, silently.
  ///
  /// A store here drops out of discovery — marketplace, search, categories,
  /// sitemap, homepage rails — but stays reachable by direct link and keeps
  /// working normally for anyone who already has it. No banner, no badge.
  ///
  /// That combination is deliberate. Suspension is a verdict and the seller is
  /// told; "under review" is a question, and a public "this store is under
  /// review" would convict a seller on the strength of an accusation that may
  /// well be false — while also warning a genuine fraudster to move on.
  isUnderReview      Boolean   @default(false)
  underReviewReason  String?
  underReviewSince   DateTime?
  underReviewById    String?
  whatsappVerifiedAt DateTime?
  averageRating      Float     @default(0.0)
  reviewCount        Int       @default(0)
  isBeta             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  underReviewBy         User?                  @relation("ShopUnderReviewBy", fields: [underReviewById], references: [id], onDelete: SetNull)
  products              Product[]
  reviews               Review[]
  reports               Report[]
  notices               Notice[]
  analytics             Analytics[]
  whatsappVerifications WhatsappVerification[]
  slugHistory           ShopSlugHistory[]

  @@index([isSuspended])
  @@index([isListed])
  @@index([isUnderReview])
}

model WhatsappVerification {
  id         String    @id @default(cuid())
  shopId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, expiresAt])
}

/// Addresses a store used to have.
///
/// Changing a slug breaks every link a seller has shared and every search
/// result pointing at the old one. Keeping the old address and redirecting is
/// the difference between a tidy-up and an outage nobody notices for a week.
model ShopSlugHistory {
  id          String   @id @default(cuid())
  shopId      String
  /// Unique across all history, so a freed slug cannot be given to another
  /// store and silently redirect its traffic somewhere else.
  slug        String   @unique
  changedAt   DateTime @default(now())
  changedById String?

  shop      Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  changedBy User? @relation("SlugChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([shopId])
}

model Product {
  id                String        @id @default(cuid())
  shopId            String
  title             String
  slug              String
  description       String?
  price             Float
  compareAtPrice    Float?
  category          String
  options           String?
  inStock           Boolean       @default(true)
  status            ProductStatus @default(ACTIVE)
  isBeta            Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  themeBg           String?
  themeSurface      String?
  themeAccent       String?
  themeAccentStrong String?
  themeText         String?
  themeMuted        String?
  themeExtractedAt  DateTime?
  discountPercent   Float?

  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  images       ProductImage[]
  analytics    Analytics[]
  wishlistedBy Wishlist[]

  @@unique([shopId, slug])
  @@index([status, category])
  @@index([shopId, status])
  @@index([createdAt])
  @@index([price])
  @@index([status, discountPercent])
  @@index([status, createdAt])
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  url          String
  displayOrder Int     @default(0)
  isPrimary    Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
}

model Review {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  /// Moderation without destruction.
  ///
  /// Before this the only way to deal with a defamatory or fake review was to
  /// delete the row. That silently rewrote the shop's rating, left no record of
  /// what had been said, and gave neither the seller nor the reviewer anything
  /// to appeal. A hidden review stops counting towards the rating and stops
  /// being shown, and is still there to look at when someone disputes it.
  isHidden     Boolean   @default(false)
  hiddenAt     DateTime?
  hiddenReason String?
  hiddenById   String?

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiddenBy User?    @relation("ReviewModerator", fields: [hiddenById], references: [id], onDelete: SetNull)
  reports  Report[]

  @@unique([shopId, userId])
  @@index([shopId, createdAt])
  @@index([shopId, isHidden, createdAt])
  @@index([isHidden, createdAt])
}

model Report {
  id     String @id @default(cuid())
  /// Always set: a review report is still a complaint about that shop, so the
  /// store's queue and the "how many open against this store" count include it
  /// without a second query.
  shopId String
  userId String

  /// What the complaint is about. `reviewId` is set if and only if this is
  /// REVIEW — enforced by a CHECK, not only by the action.
  targetType ReportTarget @default(SHOP)
  reviewId   String?

  category  ReportCategory @default(OTHER)
  reason    String
  status    ReportStatus   @default(OPEN)
  createdAt DateTime       @default(now())

  /// The SLA clock.
  ///
  /// The Consumer Protection (E-Commerce) Rules 2020 require a marketplace to
  /// acknowledge a consumer complaint within 48 hours and dispose of it within
  /// one month. Without these columns the question "did we acknowledge this in
  /// time" has no answer at all — not a bad answer, no answer — which is the
  /// worst possible position to be in when someone asks.
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  /// What was actually done, or why nothing was. Shown to the reporter.
  resolutionNote   String?

  shop           Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review         Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  acknowledgedBy User?   @relation("ReportAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@unique([reviewId, userId], name: "Report_one_per_user_per_review")
  @@index([status, createdAt])
  @@index([shopId, status])
  @@index([category, createdAt])
  @@index([targetType, status, createdAt])
  @@index([reviewId])
  /// Drives the "overdue for acknowledgement" queue.
  @@index([acknowledgedAt, createdAt])
}

/// A formal, durable message from the marketplace to a seller.
///
/// Suspension used to be communicated by a single fire-and-forget email through
/// `notify()`, which no-ops entirely when RESEND_API_KEY is unset and silently
/// swallows delivery failures otherwise. So the seller could be suspended and
/// never told, and nothing anywhere recorded that we had tried. A notice is
/// stored first and emailed second: the record does not depend on the email
/// having worked.
model Notice {
  id      String     @id @default(cuid())
  shopId  String
  actorId String
  kind    NoticeKind
  subject String
  body    String

  /// Set when the seller is being asked for something, with a date by which.
  requiresResponse Boolean   @default(false)
  respondBy        DateTime?

  sentAt      DateTime  @default(now())
  /// When the email actually left, as distinct from when the notice was issued.
  /// Null means the seller has the notice in their inbox but no email went out.
  emailedAt   DateTime?
  readAt      DateTime?
  respondedAt DateTime?
  response    String?

  shop  Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actor User @relation("NoticeAuthor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([shopId, sentAt])
  @@index([shopId, readAt])
  @@index([sentAt])
}

model Analytics {
  id        String             @id @default(cuid())
  shopId    String
  productId String?
  userId    String?
  eventType AnalyticsEventType
  createdAt DateTime           @default(now())

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId, eventType, createdAt])
  @@index([productId, eventType])
  @@index([userId, shopId, eventType, createdAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  cover           String // URL of high-end cover image
  author          String   @default("Seyon Team")
  date            DateTime @default(now())
  category        String
  tags            String[]
  readingTime     Int      @default(1)
  featured        Boolean  @default(false)
  featuredProduct String? // Slug of bound marketplace product
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String[]
  content         String   @db.Text // Markdown text body
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, date])
}

/**
 * Distributed rate-limit counters.
 * The limiter previously fell back to a per-process in-memory Map whenever
 * Upstash was unconfigured — which on Vercel means every warm instance keeps
 * its own tally, so "5 login attempts per minute" was really 5 x however many
 * instances happened to be warm, reset on every cold start. That made the
 * limits decorative in exactly the environment they matter in.
 * The database is already shared across every instance, so it can hold the
 * counters. Upstash is still used when configured (it is faster and keeps this
 * load off Postgres); this is the fallback that actually works.
 */
model RateLimitCounter {
  /**
   * Bucket key: "<prefix>:<subject>:<window start>".
   */
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/// Seller identity, held to the minimum the law actually requires of a
/// marketplace that never touches a payment.
///
/// Seyon is not a payment aggregator, so the RBI KYC directions do not apply.
/// What does apply is the Consumer Protection (E-Commerce) Rules 2020: a
/// seller's legal name, principal address and contact must be shown to buyers,
/// and the seller must undertake that their listings are accurate.
///
/// The full identifier is never stored. Only its last four characters (so a
/// seller can recognise which document is on file) and a salted hash (so the
/// same PAN opening five stores under five accounts is detectable). Document
/// images live in a private bucket and are deleted once a decision is made:
/// the decision is the record worth keeping, the image is only liability.
model SellerKyc {
  id     String    @id @default(cuid())
  userId String    @unique
  tier   KycTier   @default(TIER_0)
  status KycStatus @default(NOT_STARTED)

  // Tier 0 — no documents, required before a store is discoverable
  legalName          String?
  undertakingAt      DateTime?
  /// Which revision of the undertaking text was accepted, so a later rewrite
  /// does not silently claim a seller agreed to words they never saw.
  undertakingVersion String?

  // Tier 1 — reviewed by a human, earns the verified badge
  idType            KycIdType?
  /// Last four characters only. The full number is never written to a column.
  idLast4           String?
  /// Salted SHA-256 of the full identifier. Duplicate detection only.
  idHash            String?
  /// Key in the private kyc-documents bucket. Nulled after a decision.
  documentPath      String?
  documentDeletedAt DateTime?

  // Tier 2 — only where the seller is over the GST threshold
  gstin String?

  /// Asked of the seller rather than derived. `turnoverDeclaredAt` is required
  /// whenever this is not NOT_DECLARED — a declaration with no date cannot be
  /// aged out, and the whole point is asking again next year.
  turnoverDeclaration TurnoverDeclaration @default(NOT_DECLARED)
  turnoverDeclaredAt  DateTime?

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([idHash])
  @@index([turnoverDeclaration, turnoverDeclaredAt])
}

enum KycTier {
  TIER_0
  TIER_1
  TIER_2
}

enum KycStatus {
  NOT_STARTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

/// What a seller says about their turnover.
///
/// A declaration, not a measurement: Seyon is a discovery marketplace, buyers
/// leave for WhatsApp to transact, and nothing in this schema records a sale.
/// The marketplace cannot detect a threshold crossing, so it asks, records the
/// date, and asks again when the answer goes stale.
enum TurnoverDeclaration {
  NOT_DECLARED
  BELOW_THRESHOLD
  ABOVE_THRESHOLD
}

enum KycIdType {
  PAN
  PASSPORT
  DRIVING_LICENCE
  VOTER_ID
  /// Masked Aadhaar only. The full Aadhaar number is never accepted or stored:
  /// the Aadhaar Act restricts holding it, and a bucket of Aadhaar images is a
  /// categorically worse breach than a bucket of product photos.
  AADHAAR_MASKED
}

/// Who did what, to whom, and why.
///
/// Suspending a store takes away a seller's livelihood and deleting a product
/// destroys their work. Until now none of it was recorded: not the actor, not
/// the time, not the reason. When a seller says "you suspended me unfairly"
/// there was nothing to answer with.
///
/// `onDelete: Restrict` on the actor is deliberate. An admin who acted cannot
/// later be deleted in a way that erases the record of what they did.
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  /// Required for anything destructive. Enforced by the action, not by hope.
  reason     String?
  /// Before/after values, so a reversal can be reconstructed.
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation("AdminActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
